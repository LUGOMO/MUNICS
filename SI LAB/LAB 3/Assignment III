import os
from cryptography.hazmat.backends import default_backend
from cryptography.hazmat.primitives.ciphers import (
    Cipher, algorithms, modes
)
# Pedimos el numero de dispositvos numero de dispositivos
n = input(f"Por favor introduzca la cantidad de dispositivos (debe ser potencia de 2): ")

# Almacenamos las claves de los nodos del arbol en un array
