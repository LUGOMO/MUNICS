from cryptography.hazmat.backends import default_backend
from cryptography.hazmat.primitives import serialization
from cryptography.hazmat.primitives.asymmetric import rsa, padding
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
import os

# Función para leer una clave privada desde un archivo PEM
def load_private_key(filepath):
    with open(filepath, "rb") as key_file:
        private_key = serialization.load_pem_private_key(
            key_file.read(),
            password=None,
            backend=default_backend()
        )
    return private_key

# Función para leer múltiples claves públicas desde archivos PEM
def load_public_keys(filepaths):
    public_keys = []
    for path in filepaths:
        with open(path, "rb") as key_file:
            public_key = serialization.load_pem_public_key(
                key_file.read(),
                backend=default_backend()
            )
            public_keys.append(public_key)
    return public_keys

# Función para encriptar un mensaje usando encriptación anidada (enrutamiento de cebolla)
def nested_encrypt_message(public_keys, message, sender_id, recipient_id):
    # Formatear el mensaje original con el remitente y el destinatario final
    message_with_sender = f"{sender_id}:{message}"
    plaintext = f"end,{recipient_id},{message_with_sender}".encode()

    # Aplicar la encriptación anidada
    for public_key in reversed(public_keys):
        # Generar clave simétrica AES de 128 bits
        key = AESGCM.generate_key(bit_length=128)
        aesgcm = AESGCM(key)
        
        # Generar nonce (valores aleatorios para AES-GCM)
        nonce = os.urandom(12)

        # Cifrar el mensaje con AES-GCM usando la clave simétrica
        ciphertext = aesgcm.encrypt(nonce, plaintext, None)

        # Cifrar la clave AES con la clave pública RSA
        encrypted_key = public_key.encrypt(
            key,
            padding.OAEP(
                mgf=padding.MGF1(algorithm=hashes.SHA256()),
                algorithm=hashes.SHA256(),
                label=None
            )
        )

        # El nuevo plaintext se convierte en el par (encrypted_key, ciphertext) para el siguiente hop
        plaintext = f"{encrypted_key.hex()},{nonce.hex()},{ciphertext.hex()}".encode()

    # Devolver el mensaje completamente encriptado
    return plaintext

# Función para desencriptar un hop del mensaje
def decrypt_hop(private_key, encrypted_message):
    # Dividir el mensaje en las partes (clave cifrada, nonce, mensaje cifrado)
    encrypted_key_hex, nonce_hex, ciphertext_hex = encrypted_message.decode().split(',')

    # Convertir los valores hexadecimales de vuelta a bytes
    encrypted_key = bytes.fromhex(encrypted_key_hex)
    nonce = bytes.fromhex(nonce_hex)
    ciphertext = bytes.fromhex(ciphertext_hex)

    # Desencriptar la clave AES simétrica usando la clave privada RSA
    key = private_key.decrypt(
        encrypted_key,
        padding.OAEP(
            mgf=padding.MGF1(algorithm=hashes.SHA256()),
            algorithm=hashes.SHA256(),
            label=None
        )
    )

    # Desencriptar el mensaje con AES-GCM usando la clave simétrica desencriptada
    aesgcm = AESGCM(key)
    plaintext = aesgcm.decrypt(nonce, ciphertext, None)

    return plaintext

